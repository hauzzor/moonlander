{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "*git add*": "ask",
      "*git commit*": "ask",
      "*git push*": "ask",
      "*npm.cmd run deliver*": "ask",
      "*node scripts/deliver*": "ask",
      "*Remove-Item*": "deny",
      "rm *": "deny",
      "*; rm *": "deny",
      "*&& rm *": "deny",
      "*| rm *": "deny",
      "*rmdir*": "deny",
      "del *": "deny",
      "*; del *": "deny",
      "*&& del *": "deny",
      "*| del *": "deny",
      "erase *": "deny",
      "*; erase *": "deny",
      "*&& erase *": "deny",
      "*| erase *": "deny",
      "*Clear-Content*": "deny",
      "*format *": "deny",
      "*diskpart*": "deny",
      "*shutdown*": "deny",
      "*Restart-Computer*": "deny",
      "*Stop-Computer*": "deny",
      "*Set-ExecutionPolicy*": "deny",
      "*reg delete*": "deny",
      "*reg add*": "deny",
      "*sc delete*": "deny",
      "*net user*": "deny",
      "*Stop-Process*": "deny",
      "*taskkill*": "deny",
      "*Start-Process*": "deny",
      "*Invoke-Expression*": "deny",
      "*powershell *": "deny",
      "*pwsh *": "deny",
      "*cmd /c*": "deny",
      "*cmd.exe*": "deny",
      "*bash -c*": "deny",
      "*sh -c*": "deny",
      "*git push --force*": "deny",
      "*git push -f*": "deny",
      "*git reset --hard*": "deny",
      "*git clean*": "deny",
      "*git checkout -- *": "deny",
      "*git checkout .*": "deny",
      "*git restore *": "deny",
      "*git rebase*": "deny",
      "*git commit --amend*": "deny",
      "*git filter-branch*": "deny",
      "*git filter-repo*": "deny",
      "*git update-ref -d*": "deny",
      "*git branch -D*": "deny",
      "*git tag -d*": "deny",
      "*git stash drop*": "deny",
      "*git stash clear*": "deny",
      "*git worktree remove*": "deny",
      "*git worktree prune*": "deny",
      "*git remote remove*": "deny",
      "*git remote set-url*": "deny",
      "*git config --global*": "deny",
      "*git config --system*": "deny",
      "*npm.cmd publish*": "deny",
      "*npm.cmd unpublish*": "deny",
      "*npm.cmd deprecate*": "deny",
      "*npm.cmd owner*": "deny",
      "*npm.cmd access*": "deny",
      "*npm.cmd token*": "deny",
      "*npm.cmd login*": "deny",
      "*npm.cmd logout*": "deny",
      "*npm.cmd adduser*": "deny",
      "*npm.cmd config set*": "deny",
      "*npm.cmd config delete*": "deny",
      "*Get-Content*.env*": "deny",
      "*Get-Content*.npmrc*": "deny",
      "*Get-Content*.pem*": "deny",
      "*Get-Content*.key*": "deny",
      "*Get-Content*id_rsa*": "deny",
      "*type *.env*": "deny",
      "*type *.npmrc*": "deny",
      "*cat *.env*": "deny",
      "*cat *.npmrc*": "deny",
      "*more *.env*": "deny",
      "*more *.npmrc*": "deny",
      "*Select-String*.env*": "deny",
      "*Select-String*.npmrc*": "deny",
      "*findstr*.env*": "deny",
      "*findstr*.npmrc*": "deny",
      "*git show*.env*": "deny",
      "*git diff*.env*": "deny",
      "*git log*.env*": "deny",
      "*git grep*.env*": "deny",
      "*Invoke-RestMethod -Method Post*": "deny",
      "*Invoke-RestMethod -Method Put*": "deny",
      "*Invoke-RestMethod -Method Delete*": "deny",
      "*Invoke-WebRequest -Method Post*": "deny",
      "*Invoke-WebRequest -Method Put*": "deny",
      "*Invoke-WebRequest -Method Delete*": "deny",
      "*curl -X POST*": "deny",
      "*curl -X PUT*": "deny",
      "*curl -X DELETE*": "deny",
      "*curl --request POST*": "deny",
      "*curl --request PUT*": "deny",
      "*curl --request DELETE*": "deny",
      "*gh secret*": "deny",
      "*gh auth*": "deny",
      "*gh repo delete*": "deny",
      "*gh release delete*": "deny",
      "*gh pr merge*": "deny",
      "*gh workflow run*": "deny"
    }
  }
}
